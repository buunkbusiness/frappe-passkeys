#: passkeys/enforcement_admin.py:35
msgid "(empty)"
msgstr "(leeg)"

#: passkeys/notifications.py:202
msgid "(from IP {0})"
msgstr "(vanaf IP {0})"

#. Content of the 'Resolved Configuration' (HTML) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"<p class=\"text-muted small\">The resolved RP ID and origins are "
"validated when a login mode is enabled.</p>"
msgstr ""
"<p class=\"text-muted small\">De bepaalde RP ID en origins worden "
"gecontroleerd als een inlogmodus wordt ingeschakeld.</p>"

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:84
msgid "A WebAuthn credential ID digest is immutable."
msgstr "De digest van een WebAuthn-credential-ID kan niet worden gewijzigd."

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:82
msgid "A WebAuthn credential ID is immutable."
msgstr "Een WebAuthn-credential-ID kan niet worden gewijzigd."

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:86
msgid "A WebAuthn credential public key is immutable."
msgstr "De publieke sleutel van een WebAuthn-credential kan niet worden gewijzigd."

#: passkeys/passkeys/doctype/webauthn_user_handle/webauthn_user_handle.py:86
msgid "A WebAuthn user handle is immutable."
msgstr "Een WebAuthn-gebruikershandle kan niet worden gewijzigd."

#: passkeys/confirm.py:475
msgid "A confirmation action is required."
msgstr "Er is een bevestigingsactie nodig."

#: passkeys/posture.py:343
msgid ""
"A custom app can register its own auth hooks or login endpoints, which "
"cannot be detected deterministically."
msgstr ""
"Een eigen app kan zijn eigen authenticatiehooks of inlogeindpunten "
"toevoegen. Die kunnen niet met zekerheid worden opgespoord."

#: passkeys/notifications.py:35
msgid ""
"A new passkey ({0}) was just added to your account on {1}.{2} If this "
"wasn't you, remove it and change your password immediately."
msgstr ""
"Er is zojuist een nieuwe passkey ({0}) aan je account toegevoegd op "
"{1}.{2} Was jij dit niet? Verwijder de passkey dan en wijzig meteen je "
"wachtwoord."

#: passkeys/notifications.py:61
msgid ""
"A passkey ({0}) on your account was disabled by an administrator on {1}. "
"You can no longer sign in with it. Contact your administrator if this was"
" unexpected."
msgstr ""
"Een beheerder heeft de passkey ({0}) van je account uitgeschakeld op {1}."
" Je kunt er niet meer mee inloggen. Neem contact op met je beheerder als "
"dit niet de bedoeling was."

#: passkeys/notifications.py:48
msgid ""
"A passkey ({0}) was removed from your account on {1}.{2} If this wasn't "
"you, review your passkeys and sign-in methods."
msgstr ""
"De passkey ({0}) is op {1} van je account verwijderd.{2} Was jij dit "
"niet? Controleer dan je passkeys en inlogmethoden."

#: passkeys/api/credentials.py:89 passkeys/api/credentials.py:93
msgid "A passkey name cannot be empty."
msgstr "De naam van een passkey mag niet leeg zijn."

#: passkeys/notifications.py:60
msgid "A passkey on your account was disabled"
msgstr "Een passkey op je account is uitgeschakeld"

#: passkeys/notifications.py:73
msgid "A passkey on your account was flagged"
msgstr "Een passkey op je account is gemarkeerd"

#: passkeys/notifications.py:34
msgid "A passkey was added to your account"
msgstr "Er is een passkey aan je account toegevoegd"

#: passkeys/notifications.py:47
msgid "A passkey was removed from your account"
msgstr "Er is een passkey van je account verwijderd"

#: passkeys/posture.py:251
msgid ""
"A sign-count regression (a possible cloned passkey) is flagged and the "
"owner notified, but the sign-in still succeeds."
msgstr ""
"Als de tellerstand lager is dan eerder (mogelijk een gekloonde passkey), "
"wordt dit gemarkeerd en krijgt de eigenaar een melding. Inloggen lukt dan"
" nog wel."

#: passkeys/notifications.py:74
msgid ""
"A sign-in with your passkey ({0}) on {1} triggered a security check "
"({2}). This can indicate a cloned authenticator. If you did not recognize"
" a recent sign-in, remove this passkey and review your account."
msgstr ""
"Bij het inloggen met je passkey ({0}) op {1} sloeg een "
"beveiligingscontrole aan ({2}). Dit kan wijzen op een gekloonde "
"authenticator. Herken je een recente inlogpoging niet? Verwijder deze "
"passkey dan en controleer je account."

#: passkeys/posture.py:197
msgid "A user can sign in through an emailed link without a passkey."
msgstr "Een gebruiker kan inloggen via een e-maillink, zonder passkey."

#: passkeys/posture.py:119
msgid "A user can sign in through these identity providers without a passkey."
msgstr "Een gebruiker kan via deze identiteitsproviders inloggen zonder passkey."

#: passkeys/posture.py:144
msgid ""
"A user can sign in with their LDAP / Active Directory password instead of"
" a passkey."
msgstr ""
"Een gebruiker kan inloggen met zijn LDAP- of Active Directory-wachtwoord "
"in plaats van een passkey."

#: passkeys/notifications.py:122
msgid "A user cannot satisfy passkey enrollment enforcement"
msgstr ""
"Een gebruiker kan niet voldoen aan de verplichting om een passkey in te "
"stellen"

#. Description of the 'Roles' (Table MultiSelect) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "A user is in scope if they hold any of these roles."
msgstr "Een gebruiker valt binnen het bereik als hij een van deze rollen heeft."

#: passkeys/passkey.py:492
msgid "A verification code could not be started for this sign-in."
msgstr "Er kon geen verificatiecode worden gestart voor dit inloggen."

#: passkeys/passkey.py:480
msgid "A verification code is not available for this sign-in."
msgstr "Er is geen verificatiecode beschikbaar voor dit inloggen."

#. Label of the aaguid (Data) field in DocType 'WebAuthn Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "AAGUID"
msgstr "AAGUID"

#: passkeys/api/credentials.py:233
msgid "Add a passkey before turning on passkey-only login."
msgstr "Voeg een passkey toe voordat je inloggen met alleen een passkey aanzet."

#. Description of the 'Passkey Origins' (Small Text) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Additional allowed origins, one per line (explicit ports allowed). Each "
"must be HTTPS and within the RP ID's scope."
msgstr ""
"Extra toegestane origins, één per regel (expliciete poorten zijn "
"toegestaan). Elke origin moet HTTPS gebruiken en binnen het bereik van de"
" RP ID vallen."

#. Description of the 'Always require a passkey from System Managers' (Check)
#. field in DocType 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Adds System Managers and Administrator to the scope above, whatever it is."
msgstr ""
"Voegt systeembeheerders en Administrator toe aan het bereik hierboven, "
"wat dat bereik ook is."

#: passkeys/posture.py:267
msgid "Administrator can still sign in with only a password."
msgstr "Administrator kan nog steeds alleen met een wachtwoord inloggen."

#. Option for the 'Require a passkey from' (Select) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "All users"
msgstr "Alle gebruikers"

#. Label of the passkey_allow_first_enrollment_on_external_login (Check) field
#. in DocType 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Allow First Passkey After Email-Link or Social Sign-in"
msgstr "Eerste passkey toestaan na inloggen via e-maillink of social login"

#. Label of the passkey_2fa_allow_otp_fallback (Check) field in DocType
#. 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Allow OTP Fallback for Passkey Second Factor"
msgstr "Terugval op eenmalige code toestaan voor passkey als tweede factor"

#. Description of the 'Allow OTP Fallback for Passkey Second Factor' (Check)
#. field in DocType 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Allow a mid-flow fallback to the configured OTP method when the passkey "
"second factor fails"
msgstr ""
"Sta tijdens het inloggen een terugval op de ingestelde OTP-methode toe "
"als de passkey als tweede factor niet werkt"

#. Label of the passkey_enforce_privileged_always (Check) field in DocType
#. 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Always require a passkey from System Managers"
msgstr "Altijd een passkey eisen van systeembeheerders"

#: passkeys/posture.py:105
msgid ""
"An enrolled user can finish password sign-in with a verification code "
"instead of a passkey."
msgstr ""
"Een gebruiker met een passkey kan het inloggen met wachtwoord afronden "
"met een verificatiecode in plaats van een passkey."

#. Label of the passkey_android_package_name (Data) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Android Package Name"
msgstr "Android-pakketnaam"

#. Label of the passkey_android_cert_fingerprints (Small Text) field in DocType
#. 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Android Signing Certificate SHA-256 Fingerprints"
msgstr "SHA-256-vingerafdrukken van het Android-ondertekeningscertificaat"

#. Description of the 'Android Package Name' (Data) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Android application id for the served /.well-known/assetlinks.json, e.g. "
"com.example.app. Leave blank to omit assetlinks.json."
msgstr ""
"Android-applicatie-ID voor het aangeboden bestand /.well-"
"known/assetlinks.json, bijvoorbeeld com.example.app. Laat leeg om "
"assetlinks.json weg te laten."

#: passkeys/well_known.py:111
msgid ""
"Android fingerprint on line {0} is not a SHA-256 certificate fingerprint "
"(64 hex characters, colons optional)."
msgstr ""
"De Android-vingerafdruk op regel {0} is geen "
"SHA-256-certificaatvingerafdruk (64 hexadecimale tekens, dubbele punten "
"optioneel)."

#: passkeys/posture.py:89
msgid "Any user can sign in with a username and password instead of a passkey."
msgstr ""
"Elke gebruiker kan inloggen met een gebruikersnaam en wachtwoord in "
"plaats van een passkey."

#: passkeys/posture.py:223
msgid ""
"Anyone who controls a user's email can reset the password and then sign "
"in without a passkey."
msgstr ""
"Iedereen die de e-mail van een gebruiker beheert, kan het wachtwoord "
"resetten en daarna zonder passkey inloggen."

#. Description of the 'iOS Team ID' (Data) field in DocType 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Apple Team ID (App ID Prefix) for the served /.well-known/apple-app-site-"
"association, e.g. ABCDE12345."
msgstr ""
"Apple Team ID (App ID-voorvoegsel) voor het aangeboden bestand /.well-"
"known/apple-app-site-association, bijvoorbeeld ABCDE12345."

#. Label of the attestation_format (Data) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Attestation Format"
msgstr "Attestatieformaat"

#. Label of the attestation_object (Long Text) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Attestation Object"
msgstr "Attestatieobject"

#. Label of the authenticator_attachment (Select) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Authenticator Attachment"
msgstr "Type authenticator"

#. Description of the 'Backup Eligible' (Check) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "BE flag; write-once at registration, never updated"
msgstr "BE-vlag; eenmalig vastgelegd bij registratie, nooit bijgewerkt"

#. Description of the 'Backup State' (Check) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "BS flag; refreshed on every successful assertion"
msgstr "BS-vlag; bij elke geslaagde controle bijgewerkt"

#. Label of the backup_eligible (Check) field in DocType 'WebAuthn Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Backup Eligible"
msgstr "Back-up mogelijk"

#. Label of the backup_state (Check) field in DocType 'WebAuthn Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Backup State"
msgstr "Back-upstatus"

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:88
msgid "Backup eligibility is set at registration and can never change."
msgstr ""
"Of een back-up mogelijk is, wordt bij registratie bepaald en kan nooit "
"veranderen."

#. Description of the 'Starting on' (Date) field in DocType 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Blank = immediately. Until this date in-scope users are nudged instead of"
" required."
msgstr ""
"Leeg = meteen. Tot deze datum krijgen gebruikers binnen het bereik alleen"
" een herinnering en is een passkey nog niet verplicht."

#. Option for the 'Device cannot create a passkey' (Select) field in DocType
#. 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Block + Notify Admin"
msgstr "Blokkeren + beheerder waarschuwen"

#: passkeys/auth_hooks.py:185
msgid ""
"Cannot disable Two Factor Authentication: it is the structural backstop "
"for Passkey as Second Factor. The final login veto remains fail-closed, "
"but the required defence-in-depth floor would be lost. Disable 'Passkey "
"as Second Factor' in Passkey Settings first."
msgstr ""
"Tweestapsverificatie kan niet worden uitgeschakeld: het is het vangnet "
"voor Passkey als tweede factor. De laatste controle bij het inloggen "
"blijft veilig geblokkeerd bij fouten, maar de vereiste extra "
"beveiligingslaag zou verdwijnen. Schakel eerst 'Passkey als tweede "
"factor' uit in Passkey-instellingen."

#: passkeys/auth_hooks.py:170
msgid ""
"Cannot disable username/password login while Passkey as Second Factor is "
"the only passkey mode: enrolled users would have no way to sign in. "
"Enable Login with Passkey or turn off Passkey as Second Factor in Passkey"
" Settings first."
msgstr ""
"Inloggen met gebruikersnaam en wachtwoord kan niet worden uitgeschakeld "
"zolang Passkey als tweede factor de enige passkey-modus is: gebruikers "
"met een passkey kunnen dan niet meer inloggen. Schakel eerst Inloggen met"
" passkey in, of zet Passkey als tweede factor uit in Passkey-"
"instellingen."

#: passkeys/policy.py:57
msgid ""
"Cannot enable passkeys because the WebAuthn dependencies could not be "
"imported: {0}."
msgstr ""
"Passkeys kunnen niet worden ingeschakeld, omdat de WebAuthn-"
"afhankelijkheden niet konden worden geladen: {0}."

#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.py:68
msgid ""
"Cannot enable passkeys: no Relying Party ID resolves. Fix it one of two "
"ways: set host_name in the site config (site_config.json) to this site's "
"domain, or enter an explicit Passkey RP ID (a bare host name) in the "
"Passkey RP ID field."
msgstr ""
"Passkeys kunnen niet worden ingeschakeld: er is geen Relying Party ID te "
"bepalen. Los dit op een van twee manieren op: stel host_name in de site-"
"config (site_config.json) in op het domein van deze site, of vul een "
"eigen Passkey RP ID (alleen een hostnaam) in bij het veld Passkey RP ID."

#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.py:59
msgid ""
"Cannot enable passkeys: the 'webauthn' python package is not installed in"
" this bench. Run bench setup requirements for the passkeys app first."
msgstr ""
"Passkeys kunnen niet worden ingeschakeld: het Python-pakket 'webauthn' is"
" niet geïnstalleerd in deze bench. Voer eerst bench setup requirements "
"uit voor de passkeys-app."

#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.py:77
msgid ""
"Cannot enable passkeys: the encryption_key in this site's "
"site_config.json is empty. Remove the empty entry so Frappe can create a "
"new key, or restore the original key."
msgstr ""
"Passkeys kunnen niet worden ingeschakeld: de encryption_key in "
"site_config.json van deze site is leeg. Verwijder de lege regel zodat "
"Frappe een nieuwe sleutel kan maken, of zet de oorspronkelijke sleutel "
"terug."

#: passkeys/passkey.py:41
msgid ""
"Cannot merge {0} into {1}: both users have passkeys. Delete the passkeys "
"and the WebAuthn User Handle of {0} first."
msgstr ""
"{0} kan niet worden samengevoegd met {1}: beide gebruikers hebben "
"passkeys. Verwijder eerst de passkeys en de WebAuthn User Handle van {0}."

#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.py:144
msgid ""
"Cannot save: this would leave no passkey-capable login mode enabled while"
" these users allow passkey login only: {0}. Keep a passkey login mode "
"enabled, or clear 'Passkey Only Login' on their WebAuthn User Handle "
"records first."
msgstr ""
"Opslaan lukt niet: er zou geen inlogmodus met passkey meer aanstaan, "
"terwijl deze gebruikers alleen met een passkey mogen inloggen: {0}. Laat "
"een inlogmodus met passkey aanstaan, of haal eerst 'Alleen inloggen met "
"passkey' weg bij hun WebAuthn User Handle-records."

#: passkeys/install.py:164
msgid ""
"Cannot uninstall passkeys: these users allow passkey login only and would"
" be locked out: {0}. Clear 'Passkey Only Login' on their WebAuthn User "
"Handle records first (WebAuthn User Handle list in Desk, or bench "
"console)."
msgstr ""
"De passkeys-app kan niet worden verwijderd: deze gebruikers mogen alleen "
"met een passkey inloggen en zouden buitengesloten raken: {0}. Haal eerst "
"'Alleen inloggen met passkey' weg bij hun WebAuthn User Handle-records "
"(via de lijst WebAuthn User Handle in Desk, of in de bench console)."

#: passkeys/install.py:155
msgid ""
"Cannot uninstall passkeys: username/password login is disabled and no "
"other login method (Social Login, LDAP, Login with Email Link) is "
"enabled. Enable one in System Settings first."
msgstr ""
"De passkeys-app kan niet worden verwijderd: inloggen met gebruikersnaam "
"en wachtwoord staat uit en er is geen andere inlogmethode ingeschakeld "
"(Social Login, LDAP, Inloggen met e-maillink). Schakel eerst een methode "
"in bij Systeeminstellingen."

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:113
msgid ""
"Cannot {0} the only enabled passkey of {1}: Disable Username/Password "
"Login is on in System Settings. Add another enabled passkey or turn off "
"Disable Username/Password Login in System Settings, then retry."
msgstr ""
"Actie '{0}' is niet mogelijk voor de enige ingeschakelde passkey van {1}:"
" 'Gebruikersnaam/wachtwoord-aanmelding uitschakelen' staat aan in "
"Systeeminstellingen. Voeg nog een ingeschakelde passkey toe of zet "
"'Gebruikersnaam/wachtwoord-aanmelding uitschakelen' uit in "
"Systeeminstellingen en probeer het opnieuw."

#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.py:107
msgid ""
"Cannot {0} the only enabled passkey of {1}: passwordless login is on for "
"that account, so this would lock them out. Clear 'Passkey Only Login' on "
"their WebAuthn User Handle first (or ensure another login method), then "
"retry."
msgstr ""
"Actie '{0}' is niet mogelijk voor de enige ingeschakelde passkey van {1}:"
" inloggen zonder wachtwoord staat aan voor dit account, dus die gebruiker"
" zou buitengesloten raken. Haal eerst 'Alleen inloggen met passkey' weg "
"bij de WebAuthn User Handle van die gebruiker (of zorg voor een andere "
"inlogmethode) en probeer het opnieuw."

#: passkeys/api/credentials.py:179
msgid "Change passkey-only login"
msgstr "Inloggen met alleen een passkey wijzigen"

#: passkeys/public/js/passkey_settings.js:70
msgid "Change the RP ID?"
msgstr "RP ID wijzigen?"

#. Description of the 'Passkey RP ID' (Data) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid ""
"Changing the RP ID invalidates every existing passkey. This cannot be "
"undone. Blank resolves to the exact host of the site's configured "
"host_name when a login mode is enabled."
msgstr ""
"Als je de RP ID wijzigt, werken alle bestaande passkeys niet meer. Dit "
"kan niet ongedaan worden gemaakt. Als je dit leeg laat, wordt de exacte "
"host uit host_name van de site gebruikt zodra een inlogmodus is "
"ingeschakeld."

#: passkeys/public/js/passkey_settings.js:160
msgid "Checking your security posture…"
msgstr "Je beveiligingsstatus wordt gecontroleerd…"

#. Label of the client_data_json (Long Text) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Client Data JSON"
msgstr "Client Data JSON"

#: passkeys/posture.py:250
msgid "Cloned-authenticator hard-fail is off."
msgstr "Hard weigeren bij een gekloonde authenticator staat uit."

#. Label of the passkey_conditional_create (Check) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Conditional Create"
msgstr "Voorwaardelijk aanmaken"

#: passkeys/policy.py:164
msgid ""
"Configure at least one exact passkey origin or set this site's host_name "
"within the RP ID scope."
msgstr ""
"Stel minstens één exacte passkey-origin in, of stel host_name van deze "
"site in binnen het bereik van de RP ID."

#: passkeys/confirm.py:258 passkeys/confirm.py:269
msgid "Confirm it's you to continue."
msgstr "Bevestig dat jij het bent om door te gaan."

#: passkeys/session.py:320
msgid "Confirm it's you to manage passkeys."
msgstr "Bevestig dat jij het bent om passkeys te beheren."

#: passkeys/confirm.py:485 passkeys/confirm.py:487
msgid "Confirmation parameters must be an object."
msgstr "Bevestigingsparameters moeten een object zijn."

#. Label of the credential_id (Long Text) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Credential ID"
msgstr "Credential-ID"

#. Label of the credential_id_sha256 (Data) field in DocType 'WebAuthn
#. Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Credential ID SHA-256"
msgstr "Credential-ID SHA-256"

#: passkeys/engine.py:150 passkeys/engine.py:152
msgid "Cross-origin passkey ceremonies are not allowed."
msgstr "Passkey-acties vanaf een andere origin zijn niet toegestaan."

#: passkeys/posture.py:342
msgid "Custom apps may add their own login methods."
msgstr "Eigen apps kunnen hun eigen inlogmethoden toevoegen."

#. Label of the passkey_nudge_cooldown_days (Int) field in DocType 'Passkey
#. Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Days between prompts"
msgstr "Dagen tussen herinneringen"

#. Option for the 'Device cannot create a passkey' (Select) field in DocType
#. 'Passkey Settings'
#: passkeys/passkeys/doctype/passkey_settings/passkey_settings.json
msgid "Degrade to Nudge"
msgstr "Terugschakelen naar herinnering"

#. Description of the 'RP ID' (Data) field in DocType 'WebAuthn Credential'
#: passkeys/passkeys/doctype/webauthn_credential/webauthn_credential.json
msgid "Descriptive only — verification always uses site-pinned configuration"
msgstr ""
"Alleen beschrijvend — de controle gebruikt altijd de vaste configuratie "
"van de site"

